# 飛書開放平台憑證
FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_key_here

# 代理伺服器設定 (若需要)
HTTP_PROXY=http://127.0.0.1:63355
HTTPS_PROXY=http://127.0.0.1:63355
NO_PROXY=127.0.0.1,localhost,*.feishu.cn,*.larksuite.com,feishu.cn,larksuite.com
